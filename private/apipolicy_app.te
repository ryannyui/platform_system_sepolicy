type apipolicy_app, domain;
typeattribute apipolicy_app coredomain;

app_domain(apipolicy_app)
untrusted_app_domain(apipolicy_app)

# The API policy service is a system_server service that is not part of
# app_api_service, so grant the lookup explicitly.
allow apipolicy_app apipolicy_service:service_manager find;

# Binder IPC with system_server, in both directions and including the oneway
# onPolicyChanged() callback, is already covered by the generic rules:
# domain.te allows domain -> system_server:binder call, and system_server.te
# has binder_call(system_server, appdomain).
